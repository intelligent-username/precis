# Frontend/backend stuff
API_BASE_URL=http://localhost:8000                  # Vite proxy target (api) — leave as 8000, or empty to use Vite proxy
VITE_API_BASE_URL=                                  # empty = use Vite proxy (recommended for `npm run dev` + Docker)
VITE_PROXY_TARGET=http://api:8000                   # used inside Docker (frontend -> api), ignored on host
VITE_API_KEY=replace-with-a-long-random-secret      # must match PRECIS_API_KEY (baked into frontend)
OLLAMA_BASE_URL=http://127.0.0.1:11434              # Ollama's default — compose overrides to http://ollama:11434

# host Ollama folder bind-mounted to container (reuse models)
# This is specifically for Windows btw
# Replace with your own Ollama repository address
OLLAMA_HOST_DIR=C:/Users/your_username/.ollama             
PRECIS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost:7860        # Just front end + api, keep consistent

# Model addresses
DEFAULT_MODEL=phi4-mini:latest

# Update this if you add/remove models
# Or if you custom-name any of them
AVAILABLE_MODELS=phi4-mini:latest,qwen3:4b           # Only here so both front and backend have it

# API stuff
PRECIS_API_KEY=replace-with-a-long-random-secret    # Once the API is actually up, this'll be needed
MAX_SUMMARY_TOKENS=120
TEMPERATURE=0.2                                     # Keep low for stability
PRECIS_MAX_UPLOAD_BYTES=10485760
PRECIS_MAX_TRANSCRIPT_CHARS=250000 
